<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: "Change shop PC". -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_server"
        android:shortcutId="change_server"
        android:shortcutLongLabel="@string/shortcut_change_long"
        android:shortcutShortLabel="@string/shortcut_change_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.ruzzco.barbers.ConnectActivity"
            android:targetPackage="com.ruzzco.barbers" />
    </shortcut>
</shortcuts>
