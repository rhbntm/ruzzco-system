# Copy to .env (repo root) before `docker compose up`. Docker Compose reads it; it is not committed.
# MySQL uses these only when its volume is first created. web/.env DATABASE_URL must use the same
# user and password: mysql://MYSQL_USER:MYSQL_PASSWORD@localhost:3307/ruzzco_db
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=ruzzco_user
MYSQL_PASSWORD=change-me
