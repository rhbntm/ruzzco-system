generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  CASHIER
  BARBER
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  QRPH // gateway-only (PAYMENT_GATEWAY on); never in the drawer
}

// Only PAID sales count toward revenue, commission, payouts and reconciliation.
// Non-gateway sales are always PAID; a QRPH sale starts PENDING and only the server
// (webhook or status check) moves it.
enum PaymentStatus {
  PAID
  PENDING
  EXPIRED
  FAILED
}

enum GatewayProvider {
  PAYMONGO_TEST
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

enum CommissionBase {
  LIST_PRICE
  AMOUNT_PAID
}

// Why a sale's phone timestamp is not trusted to pick its business day (slice L5).
// DEVICE_CLOCK_SKEW wins when both apply: the phone's clock explains the future timestamp.
enum TimeFlag {
  FUTURE_TIMESTAMP // more than 5 minutes ahead of the server when it arrived
  DEVICE_CLOCK_SKEW // the phone's clock (sentAt) was more than 5 minutes off the server's
}

// The owner's decision for a flagged sale: count it on the day the phone stated, or on the
// Manila date the server received it.
enum TimeReviewChoice {
  STATED_DATE
  RECEIVED_DATE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      Role     @default(BARBER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Barber {
  id              String             @id @default(uuid())
  fullName        String             @map("full_name")
  commissionRate  Decimal            @default(0.50) @db.Decimal(5, 2) @map("commission_rate")
  isActive        Boolean            @default(true) @map("is_active")
  transactions    Transaction[]
  commissionLogs  CommissionLog[]
  payoutLedgers   DailyPayoutLedger[]
  deviceAssignments DeviceAssignment[]
  paymentQrs      BarberPaymentQr[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@map("barbers")
}

model Service {
  id               String            @id @default(uuid())
  name             String
  standardPrice    Decimal           @db.Decimal(10, 2) @map("standard_price")
  isActive         Boolean           @default(true) @map("is_active")
  transactionItems TransactionItem[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@map("services")
}

model Transaction {
  id                     String            @id // Client-generated UUID for offline idempotency
  cashierId              String?           @map("cashier_id")
  barberId               String            @map("barber_id")
  barber                 Barber            @relation(fields: [barberId], references: [id])
  totalAmount            Decimal           @db.Decimal(10, 2) @map("total_amount")
  listPrice              Decimal?          @db.Decimal(10, 2) @map("list_price")
  discountType           DiscountType      @default(NONE) @map("discount_type")
  discountAmount         Decimal           @default(0) @db.Decimal(10, 2) @map("discount_amount")
  amountPaid             Decimal?          @db.Decimal(10, 2) @map("amount_paid")
  tipAmount              Decimal           @default(0) @db.Decimal(10, 2) @map("tip_amount")
  customAmount           Boolean           @default(false) @map("custom_amount")
  customAmountNote       String?           @db.VarChar(255) @map("custom_amount_note")
  barberCommissionAmount Decimal           @db.Decimal(10, 2) @map("barber_commission_amount")
  // Barber's rate when the server first recorded the sale. Immutable; payouts never read
  // Barber.commissionRate. No default: a sale is never recorded with an assumed rate.
  commissionRate         Decimal           @db.Decimal(5, 2) @map("commission_rate")
  commissionBase         CommissionBase    @default(LIST_PRICE) @map("commission_base")
  paymentMethod          PaymentMethod     @default(CASH) @map("payment_method")
  paymentReference       String?           @map("payment_reference")
  paymentStatus          PaymentStatus     @default(PAID) @map("payment_status")
  gatewayPayment         GatewayPayment?
  transactionTime        DateTime          @map("transaction_time") // Client recorded time
  syncedAt               DateTime          @default(now()) @map("synced_at") // Server receipt time
  // Device assignment active on the phone when the sale was made. Authoritative for barber
  // attribution; null for legacy sales queued before assignment ids existed.
  assignmentId           String?           @map("assignment_id")
  assignment             DeviceAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  // Suspicious phone timestamp (set once at sync, never recomputed). transactionTime is kept
  // as sent. A flagged sale counts on no business day until the owner reviews it; then it
  // counts only on timeReviewedBusinessDate. Null on every ordinary sale.
  timeFlag                 TimeFlag?         @map("time_flag")
  clockSkewSeconds         Int?              @map("clock_skew_seconds") // + = phone ahead of the server
  timeReviewedAt           DateTime?         @map("time_reviewed_at")
  timeReviewChoice         TimeReviewChoice? @map("time_review_choice")
  timeReviewedBusinessDate DateTime?         @db.Date @map("time_reviewed_business_date")
  items                  TransactionItem[]
  commissionLogs         CommissionLog[]
  createdAt              DateTime          @default(now()) @map("created_at")

  @@index([barberId])
  @@index([transactionTime])
  @@index([assignmentId])
  @@index([timeFlag])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  serviceId     String      @map("service_id")
  service       Service     @relation(fields: [serviceId], references: [id])
  priceAtSale   Decimal     @db.Decimal(10, 2) @map("price_at_sale")

  @@index([transactionId])
  @@index([serviceId])
  @@map("transaction_items")
}

model CommissionLog {
  id            String      @id @default(uuid())
  barberId      String      @map("barber_id")
  barber        Barber      @relation(fields: [barberId], references: [id])
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(10, 2)
  loggedAt      DateTime    @default(now()) @map("logged_at")

  @@index([barberId])
  @@index([transactionId])
  @@map("commission_logs")
}

model DeviceAssignment {
  id           String        @id @default(uuid()) // generated on the phone at bind time; by the server for older clients
  deviceKey    String        @map("device_key") // localStorage UUID, not a secret
  barberId     String        @map("barber_id")
  barber       Barber        @relation(fields: [barberId], references: [id])
  assignedAt   DateTime      @default(now()) @map("assigned_at")
  revokedAt    DateTime?     @map("revoked_at") // null = active binding
  transactions Transaction[] // sales made under this assignment; Restrict keeps history from being deleted

  @@index([deviceKey])
  @@index([barberId])
  @@map("device_assignments")
}

/// Append-only: each save is a new revision (1, 2, ...) for its business date, never an
/// update. A row records what the owner counted and what the system expected at reconciledAt.
model ShiftReconciliation {
  id                 BigInt   @id @default(autoincrement())
  reconciliationDate DateTime @db.Date @map("reconciliation_date") // Manila business date
  revision           Int      @default(1)
  expectedCash       Decimal  @db.Decimal(10, 2) @map("expected_cash")
  countedCash        Decimal  @db.Decimal(10, 2) @map("counted_cash")
  variance           Decimal  @db.Decimal(10, 2)
  gcashTotal         Decimal  @db.Decimal(10, 2) @map("gcash_total")
  mayaTotal          Decimal  @default(0) @db.Decimal(10, 2) @map("maya_total")
  totalRevenue       Decimal  @db.Decimal(10, 2) @map("total_revenue")
  pettyCashAmount    Decimal  @default(0) @db.Decimal(10, 2) @map("petty_cash_amount")
  pettyCashNote      String?  @db.VarChar(255) @map("petty_cash_note")
  note               String?  @db.Text
  reconciledAt       DateTime @default(now()) @map("reconciled_at")

  @@unique([reconciliationDate, revision])
  @@map("shift_reconciliations")
}

model DailyPayoutLedger {
  id              BigInt   @id @default(autoincrement())
  barberId        String   @map("barber_id")
  barber          Barber   @relation(fields: [barberId], references: [id])
  businessDate    DateTime @db.Date @map("business_date")
  commissionTotal Decimal  @db.Decimal(10, 2) @map("commission_total")
  tipTotal        Decimal  @db.Decimal(10, 2) @map("tip_total")
  totalOwed       Decimal  @db.Decimal(10, 2) @map("total_owed")
  cashPaid        Decimal  @default(0) @db.Decimal(10, 2) @map("cash_paid")
  gcashPaid       Decimal  @default(0) @db.Decimal(10, 2) @map("gcash_paid")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([barberId, businessDate])
  @@index([businessDate])
  @@map("daily_payout_ledgers")
}

model DailyRevenueForecast {
  id                   BigInt   @id @default(autoincrement())
  forecastDate         DateTime @db.Date @map("forecast_date")
  predictedRevenue     Decimal  @db.Decimal(10, 2) @map("predicted_revenue")
  confidenceLowerBound Decimal? @db.Decimal(10, 2) @map("confidence_lower_bound")
  confidenceUpperBound Decimal? @db.Decimal(10, 2) @map("confidence_upper_bound")
  predictedHeadcount   Int?     @map("predicted_headcount")
  // The model's customers to one decimal (slice 7); predictedHeadcount is the same number rounded.
  predictedCustomers   Decimal? @db.Decimal(6, 1) @map("predicted_customers")
  generatedAt          DateTime @default(now()) @map("generated_at")
  runId                String?      @map("run_id")
  run                  ForecastRun? @relation(fields: [runId], references: [id])

  @@unique([forecastDate])
  @@map("daily_revenue_forecasts")
}

/// One call to the ml-service forecast (slice 7). Stores the model's version, training range
/// and test error so the owner dashboard can explain the numbers when the service is down.
/// Its days are the DailyRevenueForecast rows; a later run overwrites the same dates.
model ForecastRun {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now()) @map("created_at")
  modelVersion          String   @map("model_version")
  dataFrom              DateTime @db.Date @map("data_from")
  dataTo                DateTime @db.Date @map("data_to")
  trainingDays          Int      @map("training_days")
  avgTicket             Decimal  @db.Decimal(10, 2) @map("avg_ticket")
  typicalErrorCustomers Decimal  @db.Decimal(6, 2) @map("typical_error_customers")
  bestBaseline          String   @map("best_baseline")
  bestBaselineError     Decimal  @db.Decimal(6, 2) @map("best_baseline_error")
  weeksRfWon            Int      @map("weeks_rf_won")
  weeksTested           Int      @map("weeks_tested")
  days                  DailyRevenueForecast[]

  @@map("forecast_runs")
}

/// One gateway charge per sale (transactionId is the sale's client UUID). Status mirrors
/// PayMongo; Transaction.paymentStatus is updated with it in the same DB transaction.
model GatewayPayment {
  id            String          @id @default(uuid())
  transactionId String          @unique @map("transaction_id")
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  provider      GatewayProvider @default(PAYMONGO_TEST)
  intentId      String          @unique @map("intent_id")
  amount        Decimal         @db.Decimal(10, 2)
  status        PaymentStatus   @default(PENDING)
  createdAt     DateTime        @default(now()) @map("created_at")
  paidAt        DateTime?       @map("paid_at")
  lastEventId   String?         @map("last_event_id")

  @@map("gateway_payments")
}

/// Webhook event ids already applied; a redelivery with the same id is a no-op.
model GatewayWebhookEvent {
  eventId    String   @id @map("event_id")
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("gateway_webhook_events")
}

/// A GCash or Maya QR image the owner uploaded for a barber, shown in the POS payment modal.
/// Display only: sales never reference it. The image lives only here (and in the phones'
/// IndexedDB cache); it is never committed, seeded, logged or sent in a sale payload.
model BarberPaymentQr {
  id          String        @id @default(uuid())
  barberId    String        @map("barber_id")
  barber      Barber        @relation(fields: [barberId], references: [id])
  method      PaymentMethod // GCASH or MAYA only, enforced by the route
  contentType String        @map("content_type")
  image       Bytes         @db.MediumBlob
  sha256      String        @db.Char(64)
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([barberId, method])
  @@map("barber_payment_qrs")
}

/// Persistent audit record written whenever the sync route overrides a client-supplied
/// barberId with the barber of the sale's device assignment. console.warn alone is lost on
/// restart; this table survives indefinitely and can be queried for tamper investigations.
model SyncMismatchLog {
  id               BigInt   @id @default(autoincrement())
  transactionId    String   @map("transaction_id") // the tx whose barberId was overridden
  deviceKey        String   @map("device_key")
  claimedBarberId  String   @map("claimed_barber_id")  // what the client sent
  resolvedBarberId String   @map("resolved_barber_id") // the sale's assignment barber (authoritative)
  detectedAt       DateTime @default(now()) @map("detected_at")

  @@index([deviceKey])
  @@index([transactionId])
  @@map("sync_mismatch_logs")
}
